# --- Supabase -------------------------------------------------------------
# Claves publicables: pueden vivir en el cliente, RLS sigue mandando.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. La `service_role` salta RLS: NUNCA la prefijes con
# NEXT_PUBLIC_ ni la expongas al navegador. Sin estas dos no hay sesion
# persistente ni historico de operaciones.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesion de LALIGA -----------------------------------------------------
# Clave de cifrado de los tokens guardados (AES-256-GCM). Minimo 32
# caracteres. Rotarla invalida todas las sesiones abiertas, que es justo lo
# que debe pasar. Generar con: openssl rand -base64 48
SESSION_ENCRYPTION_KEY=

# --- Tareas programadas ----------------------------------------------------
# Secreto compartido de las rutas /api/cron/*. SIN esta variable responden 401
# a todo el mundo: un endpoint que dispara lecturas o avisos no puede quedar
# abierto porque falte configuracion.
# En Vercel, Cron manda este valor como `Authorization: Bearer`.
# Generar con: openssl rand -base64 32
CRON_SECRET=

# --- Alertas que avisan solas (opcional) ------------------------------------
# Sin esto la app funciona igual: las alertas de clausula se ven al abrir la
# pantalla, pero no avisan solas. Necesita ADEMAS sesion persistente
# (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY + SESSION_ENCRYPTION_KEY): sin
# sesion que sobreviva entre visitas no hay nada que el cron pueda evaluar
# mientras no estas mirando la app, que es justo el problema que resuelve.
#
# Las claves son FIJAS y no se regeneran nunca: cada suscripcion queda atada a
# la publica del momento en que se activo, y cambiarla invalidaria todas las
# suscripciones existentes.
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto de recuperacion que exige la especificacion Web Push (sin "mailto:", se añade solo).
VAPID_CONTACT_EMAIL=
#
# El cron que evalua las alertas: /api/cron/alerts, una vez al dia a las 9:00 UTC
# (vercel.json). Es el limite del plan gratuito de Vercel: los cron jobs de Hobby
# no pueden correr mas de una vez al dia, y NO es solo que se ignore el resto —
# un `schedule` que lo incumpla hace que Vercel RECHACE EL DESPLIEGUE ENTERO con
# `cron_jobs_limits_reached`. Ya paso una vez: se puso "*/15 * * * *" sin
# comprobar el limite y dejo la app entera sin desplegar varios commits seguidos.
# Con el plan Pro se puede apretar el intervalo sin miedo a este error.

# --- Conector de LALIGA Fantasy (opcionales) ------------------------------
# Todos tienen valor por defecto en src/server/laliga/config.ts. Solo hay que
# tocarlos si LALIGA cambia de host o de temporada.
# LALIGA_FANTASY_BASE_URL=
# LALIGA_FANTASY_PRIVATE_BASE_URL=
# LALIGA_FANTASY_COMPETITION_ID=
# LALIGA_FANTASY_TIMEOUT_MS=
# LALIGA_FANTASY_CLIENT_ID=

# ── Entrar con Google, Apple o Facebook (opcional) ───────────────────────────
# Sin esto la app funciona igual: se entra con email y contraseña de LALIGA y no
# aparece ningún botón de proveedor.
#
# NO hay una variable por proveedor. Las credenciales de Google, Apple y
# Facebook se meten en el panel de Supabase (Authentication → Providers), y la
# app le PREGUNTA a Supabase cuáles están encendidos: activar uno allí hace que
# aparezca su botón sin tocar código ni desplegar.
#
# Aquí solo hace falta la clave publicable, que es la que identifica al proyecto
# sin dar permisos de administrador. Está en Supabase → Settings → API.
SUPABASE_PUBLISHABLE_KEY=
#
# Además, en Supabase → Authentication → URL Configuration → Redirect URLs hay
# que añadir EXACTAMENTE esta, o el código de acceso se pierde por el camino:
#     https://TU-DOMINIO/api/fantasy/auth/social/callback
#
# Solo si el dominio no se deduce solo (en Vercel se deduce):
# APP_BASE_URL=

# ── Cuotas de casa de apuestas ───────────────────────────────────────────────
# No hay nada que configurar. Las cuotas 1X2 salen de un CSV abierto de
# football-data.co.uk que no pide clave ni registro. Si su servidor no responde,
# la app lo dice y el resto del calendario sigue funcionando igual.

# ── Panel privado de marketing (/marketing) ──────────────────────────────────
# Lista de correos separados por comas. SIN esta variable, /marketing queda
# cerrado para todo el mundo: falla cerrado, no abierto. No hace falta ningún
# login nuevo — basta con haber entrado una vez con Google/Facebook en LigaLab
# (misma identidad que el acceso social del producto, sesión aparte).
MARKETING_ADMIN_EMAILS=

# ── Motor de agentes de marketing (npm run marketing:radar / marketing:generate) ──
# Solo hace falta para EJECUTAR la pipeline que rellena marketing/generated/**
# (Fantasy Radar → Strategist → Copywriter → Creative Director → Video
# Director → Brand Reviewer). El panel /marketing funciona igual sin esto —
# solo lee lo que ya exista.
#
# Gasta en la API de Anthropic cada vez que se ejecuta. Por diseño, en dos
# tramos de coste (marketing/automation.config.json → tokenPolicy):
# el Radar (barato, hasta 20 ideas) usa MARKETING_AGENT_MODEL_CHEAP; la cadena
# creativa (cara, máximo `creativeCandidateLimit` piezas/día) usa
# MARKETING_AGENT_MODEL. Ninguna publica nada — solo escriben package.json a
# la espera de aprobación humana en /marketing.
ANTHROPIC_API_KEY=
# MARKETING_AGENT_MODEL=claude-opus-5
# MARKETING_AGENT_MODEL_CHEAP=claude-haiku-4-5
