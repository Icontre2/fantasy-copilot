{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LigaLab Daily Fantasy Radar",
  "type": "object",
  "required": ["date", "opportunities"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "problem", "whyNow", "feature", "hook", "formats", "score", "sources"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "problem": { "type": "string" },
          "whyNow": { "type": "string" },
          "feature": { "type": "string" },
          "hook": { "type": "string" },
          "formats": { "type": "array", "items": { "type": "string" } },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string" },
                "url": { "type": "string" },
                "publishedAt": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "riskNotes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
